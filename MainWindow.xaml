<Window x:Class="MVVMRefWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMRefWPF"
        mc:Ignorable="d"
        Title="Система контроля персонала v1.0" Height="500" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ИМЕНА КОНТРОЛОВ ВМЕСТО ПРИВЯЗОК -->
        <ListBox x:Name="listPerson" Grid.Column="0" FontSize="16"/>

        <StackPanel Grid.Column="1" Margin="5">
            <!-- КНОПКИ С ОБРАБОТЧИКАМИ ВМЕСТО КОМАНД -->
            <Button x:Name="btnAdd" Content="Добавить" FontSize="20" 
                    Height="60" Click="btnAdd_Click" Background="LightGreen"/>
            <Button x:Name="btnDel" Content="Удалить" FontSize="20" 
                    Height="60" Click="btnDel_Click" Margin="0,5,0,0" Background="LightCoral"/>
            <Button x:Name="btnEdit" Content="Изменить" FontSize="20" 
                    Height="60" Click="btnEdit_Click" Margin="0,5,0,0" Background="LightBlue"/>
            <Button x:Name="btnExport" Content="Экспорт" FontSize="20" 
                    Height="60" Click="btnExport_Click" Margin="0,5,0,0"/>
            <Button x:Name="btnClear" Content="Очистить всё" FontSize="20" 
                    Height="60" Click="btnClear_Click" Margin="0,5,0,0"/>

            <TextBlock x:Name="lblStatus" Text="Готово" Margin="0,20,0,0" 
                       FontSize="14" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
