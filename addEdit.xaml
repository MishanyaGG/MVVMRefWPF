<Window x:Class="MVVMRefWPF.addEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMRefWPF"
        mc:Ignorable="d"
        Title="Окно" Height="300" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Имя:"/>
        <TextBox x:Name="txtName" Width="250" Margin="0,0,0,10"/>

        <TextBlock Text="Возраст:"/>
        <TextBox x:Name="txtAge" Width="250" Margin="0,0,0,10"/>

        <TextBlock Text="Должность:"/>
        <TextBox x:Name="txtPos" Width="250" Margin="0,0,0,10"/>

        <Button Content="OK" Width="100" Click="Button_Click"/>
    </StackPanel>
</Window>
